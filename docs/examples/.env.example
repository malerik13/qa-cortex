# Example .env file for qa-cortex (Jira-based stack).
# Copy to .env in repo root and fill in real tokens.
# .env is gitignored — DO NOT commit.

# Jira credentials (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=ATATT3xFf...

# TestRail credentials (Phase 2 Step 3)
TESTRAIL_USERNAME=you@example.com
TESTRAIL_API_KEY=...

# Confluence (typically same as Jira if Atlassian Cloud)
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=ATATT3xFf...

# Slack (Phase 2 Step 5) — bot token from Slack app config
SLACK_BOT_TOKEN=xoxb-...
