# ─────────────────────────────────────────────────────────────
# ScaleFinal QA Assistant — per-user credentials
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in YOUR personal values.
# Never commit .env (it's in .gitignore).
#
# Each team member has their own YouTrack token — do not share.
# ─────────────────────────────────────────────────────────────

# YouTrack API (required)
# Get token: https://youtrack.scalefinal.io → Profile → Authentication → New token
YOUTRACK_BASE_URL=https://youtrack.scalefinal.io
YOUTRACK_TOKEN=perm:PASTE_YOUR_TOKEN_HERE

# YouTrack project key (TRD = ScaleFinal CRM)
YOUTRACK_PROJECT=TRD

# ─────────────────────────────────────────────────────────────
# Slack (optional — only for one-time /slack-ingest scrape)
# ─────────────────────────────────────────────────────────────
# User token scopes needed:
#   channels:history, groups:history, im:history,
#   channels:read, groups:read, users:read
SLACK_USER_TOKEN=xoxp-PASTE_HERE
SLACK_WORKSPACE=scalefinal

# ─────────────────────────────────────────────────────────────
# Allure TestOps (optional — only if you use the Allure MCP tools:
# search_test_cases / get_test_case / preview_test_case_payload)
# ─────────────────────────────────────────────────────────────
# Get token: https://scalefinal.testops.cloud → Profile → API tokens
ALLURE_BASE_URL=https://scalefinal.testops.cloud
ALLURE_TOKEN=PASTE_YOUR_TOKEN_HERE
ALLURE_PROJECT_ID=1
ALLURE_DEFAULT_TREE_ID=1
# Integration ID of the YouTrack integration in Allure TestOps. Required for
# issue-link operations. Discover it from an existing case:
#   curl -H "Authorization: Api-Token $ALLURE_TOKEN" \
#     "$ALLURE_BASE_URL/api/testcase/<existing_tc_id>/issue"
# → copy `integrationId` from the response.
ALLURE_INTEGRATION_ID=34

# ─────────────────────────────────────────────────────────────
# KB cache freshness threshold (days). SessionStart hook reminds
# to refresh when older than this.
# ─────────────────────────────────────────────────────────────
KB_STALE_DAYS=7
